VITE_API_URL=/api

# Production settings - override with actual values
VITE_APP_NAME=متجر منفذ آسيا
VITE_APP_SHORT_NAME=منفذ آسيا
VITE_APP_DESC=متجر إلكتروني حديث للمنتجات الغذائية والعروض اليومية

# Analytics (set in deployment)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=
VITE_HOTJAR_ID=
VITE_MIXPANEL_TOKEN=

# AI Services (set in deployment)
VITE_OPENAI_API_KEY=
VITE_RECOMMENDATION_API_URL=
VITE_PERSONALIZATION_API_URL=
VITE_INVENTORY_AI_API_URL=

# Payment & Commerce APIs (set in deployment)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# Social Auth Providers (enable only those configured)
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_FACEBOOK_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false

# Social APIs (set in deployment)
VITE_FACEBOOK_APP_ID=
VITE_TWITTER_API_KEY=
VITE_INSTAGRAM_ACCESS_TOKEN=

# Voice & AR APIs (set in deployment)
VITE_SPEECH_API_KEY=
VITE_AR_API_KEY=

# Enable all features in production
VITE_ENABLE_AI_RECOMMENDATIONS=false
VITE_ENABLE_AR_VIEWER=false
VITE_ENABLE_VOICE_COMMERCE=false
VITE_ENABLE_GAMIFICATION=false
VITE_ENABLE_NFT_LOYALTY=false
VITE_ENABLE_SOCIAL_COMMERCE=false
VITE_ENABLE_SMART_INVENTORY=false
VITE_ENABLE_PERSONALIZATION=false
VITE_ENABLE_SUSTAINABILITY=false

# Production monitoring (set in deployment)
VITE_SENTRY_DSN=
VITE_LOGROCKET_APP_ID=
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Security
VITE_CSP_ENABLED=true
VITE_ENABLE_HTTPS_REDIRECT=true

# PWA
VITE_PWA_ENABLED=true
VITE_CACHE_VERSION=v1.0.0

# Backend dynamic host/port (production build dev testing)
# If serving the frontend separately and calling a remote API, set host here.
# VITE_BACKEND_HOST=https://api.example.com:8829
# VITE_BACKEND_PORT=8829