# Staging Environment Configuration
# This file is automatically loaded by Vite when NODE_ENV=staging

# API Configuration
VITE_API_URL=https://asia-store-staging.onrender.com/api
VITE_PROXY_TARGET=https://asia-store-staging.onrender.com

# Environment Settings
VITE_NODE_ENV=staging
VITE_APP_NAME=Asia Store - Staging
VITE_APP_VERSION=1.0.0-staging

# Development Features (disabled in staging)
VITE_DEV_HEADERS=true
VITE_DEV_USER_ID=admin
VITE_DEV_USER_ROLE=admin
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Feature Flags
VITE_ENABLE_AI_RECOMMENDATIONS=true
VITE_ENABLE_AR_VIEWER=true
VITE_ENABLE_VOICE_COMMERCE=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_NFT_LOYALTY=true
VITE_ENABLE_SOCIAL_COMMERCE=true
VITE_ENABLE_SMART_INVENTORY=true
VITE_ENABLE_PERSONALIZATION=true
VITE_ENABLE_SUSTAINABILITY=true

# Analytics and Monitoring
VITE_GA_TRACKING_ID=G-STAGING-TRACKING-ID
VITE_GTM_ID=GTM-STAGING-ID
VITE_SENTRY_DSN=https://staging@sentry.io/project-id

# Service URLs
VITE_RECOMMENDATION_API_URL=https://asia-store-staging.onrender.com/api/recommendations
VITE_PERSONALIZATION_API_URL=https://asia-store-staging.onrender.com/api/personalization
VITE_INVENTORY_AI_API_URL=https://asia-store-staging.onrender.com/api/inventory-ai

# Payment Configuration (Staging/Sandbox)
VITE_STRIPE_PUBLIC_KEY=pk_test_stripe_key
VITE_PAYPAL_CLIENT_ID=sb_staging_paypal_client_id
VITE_STC_PAY_ENABLED=true
VITE_STC_PAY_ENVIRONMENT=staging

# Shipping Configuration
VITE_SMSA_ENABLED=true
VITE_SMSA_ENVIRONMENT=staging
VITE_ARAMEX_ENABLED=true
VITE_ARAMEX_ENVIRONMENT=staging

# Cache Configuration
VITE_CACHE_TTL=300
VITE_ENABLE_OFFLINE=true
VITE_OFFLINE_STRATEGY=cache-first

# Security Settings
VITE_CSP_ENABLED=true
VITE_CSP_REPORT_ONLY=false

# Build Configuration
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=true

# HMR Configuration (for development builds)
VITE_HMR_CLIENT_HOST=localhost
VITE_HMR_CLIENT_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=5174