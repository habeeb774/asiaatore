# Database
DATABASE_URL="mysql://u556377194_asia:2721@#$&2724@#$&Ah@HOST:3306/u556377194_asia_store_db"
# Server Configuration
PORT=8829
NODE_ENV=production
LOG_LEVEL=info

# Security (IMPORTANT: Replace with strong production values)
ENCRYPTION_KEY=production_encryption_key_32_chars_long
AUTH_SECRET=production_jwt_secret_change_me_immediately
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS
CORS_ORIGIN=https://www.manfadasia.com

# Rate Limiting
RATE_LIMIT_AUTH_ENABLE=true
RATE_LIMIT_PAY_ENABLE=true
RATE_LIMIT_API_ENABLE=true
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PAY_WINDOW_MS=300000
RATE_LIMIT_PAY_MAX=5
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100

# Development Features (DISABLED in Production)
ALLOW_DEV_HEADERS=false
ALLOW_QUERY_TOKEN=false
DEBUG_ERRORS=false
DEBUG_LOGIN=0
ALLOW_INVALID_DB=false
QUICK_START_DB=0

# Email Service (Production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
