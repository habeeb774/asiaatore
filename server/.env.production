FRONTEND_URL=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# Security Headers
FORCE_HTTPS=true
TRUST_PROXY=true

# Performance
COMPRESSION_THRESHOLD=1024
JSON_LIMIT=1mb

# CSRF Protection
DISABLE_CSRF=false
