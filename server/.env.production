# ===============================
# 🌐 Database Connection
# ===============================

# Prisma connection (Production - UPDATE WITH REAL PRODUCTION DB)
DATABASE_URL="mysql://production_user:production_password@production-host:3306/production_db"
ALLOW_INVALID_DB=false
# Quick start fallback (Railway)
# QUICK_START_DB=0

# ===============================
# 🔐 Authentication / Tokens - PRODUCTION KEYS (UPDATE THESE!)
# ===============================
AUTH_SECRET="UPDATE_THIS_WITH_STRONG_PRODUCTION_SECRET_64_CHARS_MINIMUM"
JWT_SECRET=${AUTH_SECRET}
COOKIE_SECRET=${AUTH_SECRET}
COOKIE_SAMESITE=lax

# ===============================
# 🌐 API / Backend Configuration
# ===============================
PORT=3000
SERVE_CLIENT=true
CORS_ORIGIN=https://manfadasia.com,https://www.manfadasia.com,https://manafadasiacompany.store
ALLOW_DEV_HEADERS=false
TRUST_PROXY=true
ENCRYPTION_KEY="UPDATE_THIS_WITH_32_CHAR_PRODUCTION_ENCRYPTION_KEY"

# ===============================
# 🔧 Production Settings (ENABLE FOR PRODUCTION!)
# ===============================
RATE_LIMIT_API_ENABLE=true
RATE_LIMIT_AUTH_ENABLE=true
RATE_LIMIT_PAY_ENABLE=true

# ===============================
# 🌐 CORS / Frontend Origins
# ===============================
CORS_ORIGIN=https://manfadasia.com,https://www.manfadasia.com,https://manafadasiacompany.store

# ===============================
# 🌐 Client Proxy Configuration
# ===============================
VITE_PROXY_TARGET=http://localhost:${PORT}
VITE_API_URL=/api

# ===============================
# 💳 PayPal Configuration - PRODUCTION (UPDATE WITH LIVE KEYS!)
# ===============================
PAYPAL_CLIENT_ID="UPDATE_WITH_PRODUCTION_PAYPAL_CLIENT_ID"
PAYPAL_SECRET="UPDATE_WITH_PRODUCTION_PAYPAL_SECRET"
PAYPAL_API=https://api-m.paypal.com

# ===============================
# 💳 Stripe Configuration - PRODUCTION (ADD THESE!)
# ===============================
STRIPE_SECRET_KEY="sk_live_UPDATE_WITH_PRODUCTION_STRIPE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_UPDATE_WITH_PRODUCTION_WEBHOOK_SECRET"

# ===============================
# 📧 Email Service - PRODUCTION (UPDATE WITH REAL SERVICE!)
# ===============================
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_USER="your-email@your-domain.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@manfadasia.com"

# ===============================
# 📱 SMS Service - PRODUCTION (UPDATE WITH REAL SERVICE!)
# ===============================
TWILIO_ACCOUNT_SID="UPDATE_WITH_PRODUCTION_TWILIO_SID"
TWILIO_AUTH_TOKEN="UPDATE_WITH_PRODUCTION_TWILIO_TOKEN"
TWILIO_FROM="+1234567890"

# ===============================
# 🚚 Shipping Services - PRODUCTION (UPDATE WITH REAL ACCOUNTS!)
# ===============================
SMSA_API_KEY="UPDATE_WITH_PRODUCTION_SMSA_KEY"
SMSA_SANDBOX=0

ARAMEX_API_KEY="UPDATE_WITH_PRODUCTION_ARAMEX_KEY"
ARAMEX_API_USER="UPDATE_WITH_PRODUCTION_ARAMEX_USER"
ARAMEX_API_PASS="UPDATE_WITH_PRODUCTION_ARAMEX_PASS"

# ===============================
# 🗃️ Redis - PRODUCTION (UPDATE WITH REAL REDIS!)
# ===============================
REDIS_URL="redis://production-redis-host:6379"

# ===============================
# 🌐 URLs - PRODUCTION
# ===============================
BASE_URL=https://manfadasia.com
FRONTEND_URL=https://manfadasia.com
PUBLIC_BASE_URL=https://manfadasia.com

# ===============================
# 🔒 Security Headers - PRODUCTION
# ===============================
FORCE_HTTPS=true
NODE_ENV=production
LOG_LEVEL=info