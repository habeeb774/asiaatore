# Staging Environment Configuration
# This file is used for staging deployments
# DO NOT use production keys or sensitive data here

# Database
DATABASE_URL="mysql://root:root@localhost:3306/my_store_db"

# Server Configuration
PORT=8829
NODE_ENV=staging
LOG_LEVEL=info

# Security
ENCRYPTION_KEY=staging_encryption_key_32_chars_long
AUTH_SECRET=staging_jwt_secret_change_me_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS
CORS_ORIGIN=https://staging.your-domain.com

# Rate Limiting
RATE_LIMIT_AUTH_ENABLE=true
RATE_LIMIT_PAY_ENABLE=true
RATE_LIMIT_API_ENABLE=true
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PAY_WINDOW_MS=300000
RATE_LIMIT_PAY_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=200

# Development Features (Limited)
ALLOW_DEV_HEADERS=false
ALLOW_QUERY_TOKEN=false
DEBUG_ERRORS=false
DEBUG_LOGIN=0
ALLOW_INVALID_DB=false
QUICK_START_DB=0

# Email Service (Staging)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging-mailtrap-user
SMTP_PASS=staging-mailtrap-pass
SMTP_FROM=noreply@staging.your-domain.com

# SMS Service (Staging)
TWILIO_ACCOUNT_SID=your-staging-twilio-sid
TWILIO_AUTH_TOKEN=your-staging-twilio-token
TWILIO_FROM=+15017122661
SMS_FROM=+15017122661

# Payment Services (Test/Sandbox)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=test
PAYPAL_SECRET=test
PAYPAL_API=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=https://staging.your-domain.com/checkout/success
PAYPAL_CANCEL_URL=https://staging.your-domain.com/checkout/cancel

# STC Pay (Sandbox)
STC_API_BASE=https://api.stcpay.com.sa
STC_MERCHANT_ID=staging_merchant_id
STC_API_KEY=staging_api_key
STC_API_SECRET=staging_api_secret
STC_CALLBACK_URL=https://staging.your-domain.com/api/pay/stc/webhook

# Bank Transfer
BANK_ACCOUNT_NAME=Staging Trading Co.
BANK_ACCOUNT_IBAN=SA03 8000 0000 6080 1016 7519
BANK_NAME=Staging Bank

# Shipping Services
SMSA_API_URL=https://api.smsaexpress.com/v2
SMSA_API_KEY=staging_smsa_key
SMSA_SANDBOX=1

ARAMEX_API_URL=https://api.aramex.com
ARAMEX_API_KEY=staging_aramex_key
ARAMEX_API_USER=staging_user
ARAMEX_API_PASS=staging_pass

# Store Configuration
STORE_ORIGIN_LAT=24.7136
STORE_ORIGIN_LNG=46.6753
SHIPPING_BASE=10
SHIPPING_PER_KM=0.7
SHIPPING_MIN=15
SHIPPING_MAX=60
SHIPPING_FALLBACK=25
DEFAULT_SHIPPING_PROVIDER=aramex

# WhatsApp (Staging)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=staging_twilio_sid
TWILIO_AUTH_TOKEN=staging_twilio_token
TWILIO_FROM_NUMBER=
WHATSAPP_ENABLED=true

# Redis (Staging)
REDIS_URL=redis://staging-redis-host:6379

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Auto-create shipments
AUTO_CREATE_SHIPMENT=true

# URLs
BASE_URL=https://staging.your-domain.com
FRONTEND_URL=https://staging.your-domain.com
PUBLIC_BASE_URL=https://staging.your-domain.com
