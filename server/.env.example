# 📦 Example environment configuration file (.env)

# ✅ Direct connection URL (recommended for production)
DATABASE_URL="mysql://root:root@localhost:3306/my_store_db"

ALLOW_INVALID_DB=false
# ⚙️ Alternative: define individual DB parts (the server will assemble the URL automatically)


# 🧑‍💻 Developer options (not for production)
# QUICK_START_DB=1          # auto inject local default URL if missing
# ALLOW_INVALID_DB=true     # run API even without DB connection

# 🌐 Frontend proxy settings
VITE_PROXY_TARGET=https://localhost:8829
VITE_API_URL=/api