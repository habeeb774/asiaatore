# Development Environment Configuration
# This file is used for local development

# Database
DATABASE_URL="mysql://root:root@localhost:3306/my_store_db"
# Alternative: DATABASE_URL=postgresql://postgres:password@localhost:5432/my_store_dev?schema=public

# Server Configuration
PORT=8829
NODE_ENV=development
LOG_LEVEL=debug

# Security
ENCRYPTION_KEY=dev_encryption_key_32_chars_long
AUTH_SECRET=dev_jwt_secret_change_me_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH_ENABLE=false
RATE_LIMIT_PAY_ENABLE=false
RATE_LIMIT_API_ENABLE=false

# Development Features
ALLOW_DEV_HEADERS=true
ALLOW_QUERY_TOKEN=true
DEBUG_ERRORS=true
DEBUG_LOGIN=1
ALLOW_INVALID_DB=true
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=admin123
DEV_USER_EMAIL=user@example.com
DEV_USER_PASSWORD=user123
QUICK_START_DB=1

# Email Service (Development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
SMTP_FROM=noreply@localhost

# SMS Service (Development)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM=+15017122661
SMS_FROM=+15017122661

# Payment Services (Test/Sandbox)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=test
PAYPAL_SECRET=test
PAYPAL_API=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/checkout/success
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel

# STC Pay (Sandbox)
STC_API_BASE=https://api.stcpay.com.sa
STC_MERCHANT_ID=
STC_API_KEY=
STC_API_SECRET=
STC_CALLBACK_URL=http://localhost:8829/api/pay/stc/webhook

# Bank Transfer
BANK_ACCOUNT_NAME=Demo Trading Co.
BANK_ACCOUNT_IBAN=SA03 8000 0000 6080 1016 7519
BANK_NAME=Demo Bank

# Shipping Services
SMSA_API_URL=https://api.smsaexpress.com/v2
SMSA_API_KEY=
SMSA_SANDBOX=1

ARAMEX_API_URL=https://api.aramex.com
ARAMEX_API_KEY=
ARAMEX_API_USER=
ARAMEX_API_PASS=

# Store Configuration
STORE_ORIGIN_LAT=24.7136
STORE_ORIGIN_LNG=46.6753
SHIPPING_BASE=10
SHIPPING_PER_KM=0.7
SHIPPING_MIN=15
SHIPPING_MAX=60
SHIPPING_FALLBACK=25
DEFAULT_SHIPPING_PROVIDER=aramex

# WhatsApp (Development)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_ENABLED=false

# Redis (Optional)
# REDIS_URL=redis://localhost:6379

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Auto-create shipments
AUTO_CREATE_SHIPMENT=true
